+def words_per_minute(cues: list[Cue]) -> float | None:
+    """Speech rate: words in the cues divided by the time they cover, in minutes."""
+    words = 0
+    seconds = 0.0
+    for c in cues:
+        words += len(c.text.split())
+        seconds += (c.end - c.start)
+    if seconds == 0:
+        return None
+    return (words/seconds)*60
+
